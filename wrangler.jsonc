{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "copilot-demo-2026",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "centexhomeschool",
      "database_id": "93208096-bf65-468d-9a5d-58422e6066d7"
    }
  ],
  "vars": {
    "SITE_URL": "https://centexhomeschool.org",
    // Comma-separated emails allowed into the owner tools. Set this to your own email
    // in the Cloudflare dashboard (Worker > Settings > Variables) or here.
    "ADMIN_EMAIL": "benjamin@centexhomeschool.org",
    // Printed in every newsletter footer (required by law). A P.O. box works.
    "MAILING_ADDRESS": "3202 Saint Genevieve Dr, Leander, TX 78641"
  },
  // Daily owner summary at 8:00 a.m. Central (13:00 UTC; 7 a.m. during daylight saving time).
  // Email: works once centexhomeschool.org is onboarded in Cloudflare > Email Service > Email Sending.
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["0 13 * * *", "*/10 * * * *"] },
  "observability": { "enabled": true }
}
